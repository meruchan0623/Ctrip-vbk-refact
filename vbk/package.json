{
  "name": "vbk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VBooking web-IM desktop client (Tauri 2 host + std-only Rust cores + dependency-free TypeScript UI/adapters).",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"ui/**/*.test.ts\" \"ui/tools/*.test.mjs\" \"tools/gates/*.test.mjs\"",
    "gates": "node tools/gates/run.mjs",
    "gates:cjk": "node tools/gates/run.mjs --tree --with-deferred",
    "build:ui": "tsc -p tsconfig.build.json",
    "smoke:ui": "node ui/tests/smoke/run.mjs",
    "check": "npm run typecheck && npm run test && cargo test --manifest-path Cargo.toml",
    "bundle:ui": "node ui/tools/bundle.mjs",
    "build:macos:universal": "node tools/build-macos-universal.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
