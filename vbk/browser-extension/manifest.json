{
  "manifest_version": 3,
  "name": "VBK 浏览器登录连接",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://vbooking.ctrip.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "连接 VBK 客户端"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
