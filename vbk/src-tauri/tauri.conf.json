{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VBooking 商家客户端",
  "version": "0.1.0",
  "identifier": "tech.tsim.vbk.client",
  "build": {
    "frontendDist": "../ui/bundle",
    "beforeDevCommand": "npm run bundle:ui",
    "beforeBuildCommand": "npm run bundle:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": false
    },
    "windows": [
      {
        "label": "main",
        "title": "VBooking 商家客户端",
        "url": "apps/main/index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "visible": false,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
