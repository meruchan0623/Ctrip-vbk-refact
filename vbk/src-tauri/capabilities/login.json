{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "login",
  "description": "login local header only; the remote official login webview (login-remote-*) gets no capability",
  "windows": [
    "login"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-account-snapshot",
    "allow-account-start-login",
    "allow-account-cancel-login",
    "allow-prefs-snapshot",
    "allow-shell-window"
  ]
}