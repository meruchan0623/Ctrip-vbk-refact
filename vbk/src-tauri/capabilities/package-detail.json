{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "package-detail",
  "description": "Local host-bound TSim package details; read only, no remote URLs or authentication mutation.",
  "windows": [
    "package-detail-*"
  ],
  "permissions": [
    "allow-contract-hello",
    "core:default",
    "core:event:allow-listen",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-shell-window",
    "allow-assistant-tsim-status",
    "allow-assistant-package-detail"
  ]
}
