{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "main shell: accounts, IM, notices, order contact, shell, prefs, reminder settings, assistant",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-account-snapshot",
    "allow-account-start-login",
    "allow-account-cancel-login",
    "allow-account-switch",
    "allow-account-suspend",
    "allow-account-logout",
    "allow-account-forget",
    "allow-account-set-remark",
    "allow-account-agent-status",
    "allow-account-set-agent-status",
    "allow-im-conversation-snapshot",
    "allow-im-locate-conversation",
    "allow-im-conversations",
    "allow-im-messages",
    "allow-im-unknown-outbound",
    "allow-im-outbound-lookup",
    "allow-im-message-page",
    "allow-im-send-text",
    "allow-im-mark-read",
    "allow-im-set-top",
    "allow-im-set-mark",
    "allow-im-customer-scripts",
    "allow-im-members",
    "allow-im-invite-candidates",
    "allow-im-invite",
    "allow-im-transfer",
    "allow-im-finish",
    "allow-notice-categories",
    "allow-notice-list",
    "allow-notice-mark-read",
    "allow-order-validate-im-url",
    "allow-order-search",
    "allow-order-create-im-chat",
    "allow-shell-window",
    "allow-shell-open-window",
    "allow-shell-open-external",
    "allow-shell-open-webview",
    "allow-media-screenshot",
    "allow-media-pick",
    "allow-net-status",
    "allow-prefs-snapshot",
    "allow-prefs-set",
    "allow-notify-snapshot",
    "allow-notify-set-enabled",
    "allow-notify-set-threshold",
    "allow-notify-set-sound-enabled",
    "allow-assistant-tsim-status",
    "allow-assistant-translate",
    "allow-assistant-package-quick-view"
  ]
}