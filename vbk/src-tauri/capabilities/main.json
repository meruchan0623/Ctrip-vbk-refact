{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "main shell: accounts, IM facts, order URL validation, prefs, reminder settings",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-minimize",
    "core:window:allow-set-focus",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-account-snapshot",
    "allow-account-start-login",
    "allow-account-switch",
    "allow-account-suspend",
    "allow-account-logout",
    "allow-account-forget",
    "allow-im-push-fact",
    "allow-im-conversation-snapshot",
    "allow-im-locate-conversation",
    "allow-order-validate-im-url",
    "allow-prefs-snapshot",
    "allow-notify-set-enabled",
    "allow-notify-set-threshold",
    "allow-notify-set-sound-enabled"
  ]
}
