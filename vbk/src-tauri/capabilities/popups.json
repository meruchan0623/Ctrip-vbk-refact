{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popups",
  "description": "alarm window: snapshot and versioned round actions only; no send, no finish, no arbitrary URL",
  "windows": ["alarm"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-notify-snapshot",
    "allow-notify-open-conversation",
    "allow-notify-hide-round",
    "allow-notify-hide-all",
    "allow-notify-snooze",
    "allow-prefs-snapshot"
  ]
}
