{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popups",
  "description": "alarm window: snapshot, versioned round actions and fitting its own height only; no send, no finish, no arbitrary URL",
  "windows": [
    "alarm"
  ],
  "permissions": [
    "allow-contract-hello",
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-notify-snapshot",
    "allow-notify-open-conversation",
    "allow-notify-hide-round",
    "allow-notify-hide-all",
    "allow-notify-alarm-resize",
    "allow-prefs-snapshot"
  ]
}
