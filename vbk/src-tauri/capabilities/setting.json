{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "setting",
  "description": "setting window: prefs, reminder settings, TSim login, quick-reply management",
  "windows": [
    "setting"
  ],
  "permissions": [
    "allow-contract-hello",
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-prefs-snapshot",
    "allow-deep-link-setting-take",
    "allow-prefs-set",
    "allow-account-snapshot",
    "allow-notify-set-enabled",
    "allow-notify-set-threshold",
    "allow-notify-set-sound-enabled",
    "allow-net-status",
    "allow-shell-window",
    "allow-shell-open-window",
    "allow-shell-open-external",
    "allow-shell-open-webview",
    "allow-shell-export-diagnostics",
    "allow-shell-open-data-directory",
    "allow-assistant-tsim-status",
    "allow-assistant-tsim-login",
    "allow-assistant-tsim-logout",
    "allow-im-quick-reply-categories",
    "allow-im-quick-reply-manage-info",
    "allow-im-quick-reply-edit",
    "allow-shell-read-clipboard-text",
    "allow-shell-write-clipboard-text",
    "allow-webview-recovery-status",
    "allow-webview-recovery-retry"
  ]
}
