{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Business",
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "旅游商家IM",
        "url": "apps/main/index.html",
        "width": 1280,
        "height": 820,
        "maximized": true,
        "minWidth": 980,
        "minHeight": 640,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 14
        }
      }
    ]
  }
}
